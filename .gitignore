# Secrets & local env — never commit these.
# `env` with no dot is listed deliberately: live keys have sat in that filename.
.env
.env.*
.env.example
env
env.local
*.env

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~

# Volatile macro snapshot cache (timestamped fetch of FRED/BLS)
backend/data/processed/*/macro_cache.json
