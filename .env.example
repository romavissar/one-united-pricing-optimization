# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# ── Market selection ───────────────────────────────────────────
# Which config/<market>.yaml to load. Miami is the priority market this pass.
MARKET=miami


# ── Calibration state ──────────────────────────────────────────
# MUST stay false until the demand model has been fitted on the real MLS export
# and its diagnostics inspected by a human. Flipping this to true is an explicit
# decision, never an automatic side effect of a successful fit.
# When false, every optimize/simulate response is tagged as illustrative and the
# frontend shows a non-dismissible banner.
IS_CALIBRATED_ON_REAL_DATA=false

# Which dataset the demand model fits on: "synthetic" | "mls"
DEMAND_DATASET=synthetic


# ── Paths ──────────────────────────────────────────────────────
MLS_RAW_DIR=./data/raw/mls
SYNTHETIC_DIR=./data/synthetic
PROCESSED_DIR=./data/processed
SQLITE_PATH=./db/pricing.sqlite


# ── Macro data (US / Miami) ────────────────────────────────────
# FRED — mortgage rates (MORTGAGE30US), fed funds (FEDFUNDS), FX series.
# Free, instant: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# BLS — Miami–Fort Lauderdale CPI and employment.
# Free: https://data.bls.gov/registrationEngine/
# Works keyless at 25 requests/day; a key raises it to 500/day.
BLS_API_KEY=


# ── Optional: LLM parsing fallback ─────────────────────────────
# Only needed if MLS headers are messy enough to warrant LLM-assisted column
# mapping. The deterministic alias table in MLS_SCHEMA.md is the primary path —
# try that first. Uses OpenRouter (https://openrouter.ai/).
OPEN_ROUTER=
OLLAMA_BASE_URL=http://localhost:11434


# ── Solver / compute ───────────────────────────────────────────
SOLVER=CBC                   # CBC | GLPK | ORTOOLS
SOLVER_TIME_LIMIT_SEC=120
MONTE_CARLO_DRAWS=10000
RANDOM_SEED=42


# ── Dev servers ────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
LOG_LEVEL=INFO


# ── Not used in this pass ──────────────────────────────────────
# Listed so nobody wires them prematurely. Auth, billing, and multi-tenancy are
# out of scope; see PROJECT_BRIEF.md §7.
# DATABASE_URL=
# JWT_SECRET=
# STRIPE_SECRET_KEY=
